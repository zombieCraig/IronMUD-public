#!/bin/bash
# IronMUD first boot (generated by Terraform). Writes the bootstrap settings,
# then downloads and runs the release's bootstrap.sh. Progress:
#   sudo tail -f /var/log/ironmud-bootstrap.log
# To change settings later, edit /etc/ironmud/bootstrap.env and run
#   sudo bash /root/ironmud-bootstrap.sh
set -euo pipefail

install -d -m 0755 /etc/ironmud
umask 077
cat > /etc/ironmud/bootstrap.env <<'IRONMUD_ENV'
IRONMUD_VERSION=${version}
IRONMUD_RELEASE_REPO=${release_repo}
IRONMUD_TLS_DOMAIN=${tls_domain}
IRONMUD_TLS_EMAIL=${tls_email}
IRONMUD_TLS_ONLY=${tls_only}
IRONMUD_TLS_DNS_WAIT=${dns_wait}
IRONMUD_FIREWALL=${firewall}
IRONMUD_SWAP_MB=${swap_mb}
IRONMUD_ENV

if [ "${version}" = latest ]; then
  url="https://github.com/${release_repo}/releases/latest/download/bootstrap.sh"
else
  url="https://github.com/${release_repo}/releases/download/${version}/bootstrap.sh"
fi
command -v curl >/dev/null || { apt-get update -q && apt-get install -y -q curl ca-certificates; }
curl -fsSL --retry 5 --retry-all-errors "$url" -o /root/ironmud-bootstrap.sh
rc=0
bash /root/ironmud-bootstrap.sh || rc=$?
# The DNS wait is for first boot only; manual re-runs shouldn't stall on it.
sed -i 's/^IRONMUD_TLS_DNS_WAIT=.*/IRONMUD_TLS_DNS_WAIT=0/' /etc/ironmud/bootstrap.env
exit "$rc"
